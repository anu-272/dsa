#include<bits/stdc++.h>
using namespace std;
 
int points(int i,int j){
    if(4<=i && i<=5 && 4<=j && j<=5) return 5;
    else if(3<=i && i<=6 && 3<=j && j<=6) return 4;
    else if(2<=i && i<=7 && 2<=j && j<=7) return 3;
    else if(1<=i && i<=8 && 1<=j && j<=8) return 2;
    else return 1;
}
void solve(){
    int sum=0;
    for(int i=0;i<10;i++){
        string s;
        cin>>s;
        for(int j=0;j<10;j++){
            if(s[j]=='X') sum+=points(i,j);
        }
    }
    cout<<sum<<'\n';
} 
    
 
 
int main(){
    int n;
    cin>>n;
    for (int i = 0; i < n; i++)
    {
        solve();
    }
    
    
}
