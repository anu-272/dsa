#include<bits/stdc++.h>
using namespace std;
 
void solve(){
   int n;
   cin>>n;
   vector<int> nums(n-1);
   long long sum=0;
   for(int i=0;i<n-1;i++){
    cin>>nums[i];
    sum+=nums[i];
   }
 
//    int s=accumulate(nums.begin(),nums.end(),0);
 
   cout<<(-1)*sum<<'\n';
} 
    
 
 
int main(){
    int n;
    cin>>n;
    for (int i = 0; i < n; i++)
    {
        solve();
    }
    
    
}
