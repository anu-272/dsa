   cin>>n>>m;
   string x,s;
   cin>>x>>s;

   int count=0;
  
   for(int i=0;i<=6;i++){
    if(x.find(s)!=std::string::npos){
        cout<<count<<'\n';
        return;
    }
    else{
        x+=x;
